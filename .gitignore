# Public source inventory is opt-in. Keep local history, private data and packages.
/*
!/.gitignore
!/.gitattributes
!/CMakeLists.txt
!/README.md
!/README.zh-CN.md
!/CHANGELOG.md
!/CONTRIBUTING.md
!/SECURITY.md
!/LICENSE
!/NOTICE
!/RELEASE_NOTES.md
!/config.example.json
!/src/
!/tests/
!/scripts/
!/assets/
!/docs/
!/.github/
/scripts/*
!/scripts/build.ps1
!/scripts/refresh-app-icons.ps1
!/scripts/audit-public.py
!/scripts/package-preview.ps1
/assets/*
!/assets/app-icon/
/assets/app-icon/*
!/assets/app-icon/translator.ico
!/assets/app-icon/translator.png
!/assets/app-icon/translator.svg
!/assets/app-icon/generate_icon.py
/docs/*
!/docs/ARCHITECTURE.md
!/docs/API_COMPATIBILITY.md
!/docs/UI_BEHAVIOR.md
!/docs/PRODUCT_SPEC.md
!/docs/TESTING.md
!/docs/THIRD_PARTY_NOTICES.md
!/docs/GITHUB_RELEASE_READINESS.md
!/docs/PUBLIC_FILES.txt
!/docs/screenshots/
/docs/screenshots/*
!/docs/screenshots/light.png
!/docs/screenshots/dark.png
# Defense in depth inside all permitted directories.
**/__pycache__/
*.py[cod]
*.pdb
*.obj
*.log
.env
.env.*
config.json
config.json.*
secret-*.bin
*.pem
*.pfx
*.p12
*.key
