#include "app_resource.h"
#include <winver.h>
#include "app_version.h"
IDI_TRANSLATOR_APP ICON "../assets/app-icon/translator.ico"
1 VERSIONINFO
FILEVERSION SAT_VERSION_NUMERIC
PRODUCTVERSION SAT_VERSION_NUMERIC
FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
FILEFLAGS 0
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "FileDescription", "OCR AI Translator"
            VALUE "FileVersion", SAT_VERSION_STRING
            VALUE "InternalName", "Translator"
            VALUE "OriginalFilename", "Translator.exe"
            VALUE "ProductName", "OCR AI Translator"
            VALUE "ProductVersion", SAT_VERSION_STRING
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
